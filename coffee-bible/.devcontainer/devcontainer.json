{
  "name": "Coffee Bible",
  "dockerComposeFile": "../compose.yaml",
  "service": "app",
  "workspaceFolder": "/app",
  "overrideCommand": true,
  "shutdownAction": "stopCompose",
  "forwardPorts": [8081, 19000, 19001, 19002],
  "customizations": {
    "vscode": {
      "extensions": [
        "msjsdiag.vscode-react-native",
        "esbenp.prettier-vscode"
      ]
    }
  },
  "postCreateCommand": "npm ci"
}
