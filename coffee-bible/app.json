{
  "expo": {
    "name": "Coffee Bible",
    "slug": "coffee-bible",
    "scheme": "coffee-bible",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coffeebible.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "원두 사진을 선택하기 위해 사진 보관함에 접근합니다."
      }
    },
    "android": {
      "package": "com.coffeebible.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "원두 사진을 선택하기 위해 사진 보관함에 접근합니다.",
          "cameraPermission": false
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
